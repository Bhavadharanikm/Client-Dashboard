# Supabase project (public/anon — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The Supabase service role key (Settings → API in the Supabase dashboard).
# Bypasses RLS entirely — used only by lib/supabase/admin-client.ts to look up client
# access codes for the admin dropdown. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google service account (Sheets API, read-only) — server-only, must never reach the browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Non-secret spreadsheet IDs (Performance data and Ads ROI data sheets).
GOOGLE_SHEETS_PERFORMANCE_ID=
GOOGLE_SHEETS_ADS_ROI_ID=
